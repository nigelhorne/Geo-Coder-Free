#!/usr/bin/env perl

use warnings;
use strict;
use autodie qw(:all);
use Carp;

use FindBin qw($Bin);
use lib "$Bin/../lib";

my $path = $Bin;
$path =~ s/^(.+)\/.+/$1/;	# Remove the final directory, probably "/bin"
$ENV{'root_dir'} = $path;

eval {
	my $testnumber = $ARGV[0];
	if($testnumber =~ /^(\d+)$/) {
		doit($1);
	}
};

Carp::croak $@ if $@;

sub doit
{
	my $test = shift or Carp::croak;

	# Tests 3 and 4 simulate a browser in the US, so that the page infers the
	# country from the client's IP address.  The IP must be one that the page's
	# CGI::ACL allow-list trusts (see cgi-bin/page.fcgi): any other address gets
	# a 403 "Access Denied" instead of an answer, and the test would be checking
	# the block page rather than the geocoder.
	my $us_ip = '108.44.193.70';

	if($test == 1) {
		# print "Test 1 - q\n";
		# system("$^X $Bin/../cgi-bin/page.fcgi page=query q='1600+Pennsylvania+Avenue+NW+Washington+DC+USA'");
		system("$^X $Bin/../cgi-bin/page.fcgi page=query q='NASA+TIROS+RD+GREENBELT+MD+US'");
	} elsif($test == 2) {
		# print "Test 2 - scantext\n";
		system("$^X $Bin/../cgi-bin/page.fcgi page=query scantext='Washington+DC+USA'");
	} elsif($test == 3) {
		$ENV{'REMOTE_ADDR'} = $us_ip;	# An IP address in the US, trusted by the page's ACL
		$ENV{'SERVER_PROTOCOL'} = 'HTTP/1.1';
		system("$^X $Bin/../cgi-bin/page.fcgi page=query q='NASA+TIROS+RD+GREENBELT+MD+US'");
	} elsif($test == 4) {
		$ENV{'REMOTE_ADDR'} = $us_ip;	# An IP address in the US, so no need for country in the address
		$ENV{'SERVER_PROTOCOL'} = 'HTTP/1.1';
		system("$^X $Bin/../cgi-bin/page.fcgi page=query q='NASA+TIROS+RD+GREENBELT+MD'");
	}
}
